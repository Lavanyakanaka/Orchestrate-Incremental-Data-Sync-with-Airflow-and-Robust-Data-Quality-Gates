# ==============================================================================
# Environment Configuration for E-Commerce Airflow Incremental Sync Pipeline
# ==============================================================================

# Airflow User Identity (default: 50000 on Linux, can remain default on Windows)
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Default Airflow Webserver Admin Credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Core Airflow Settings
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqnzq8=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres-airflow:5432/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres-airflow:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0

# Airflow Connection URI to Analytical Data Warehouse
AIRFLOW_CONN_ANALYTICAL_DW_CONN=postgresql://dw_user:dw_password@postgres-dw:5432/analytical_dw

# Airflow Metadata Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Analytical Data Warehouse Database Configuration
ANALYTICAL_DB_HOST=postgres-dw
ANALYTICAL_DB_PORT=5432
ANALYTICAL_DB_HOST_PORT=5433
ANALYTICAL_DB_NAME=analytical_dw
ANALYTICAL_DB_USER=dw_user
ANALYTICAL_DB_PASSWORD=dw_password

# Alerting / SMTP Configuration (Optional)
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=alerts@example.com
AIRFLOW__SMTP__SMTP_PASSWORD=app_specific_password
AIRFLOW__SMTP__SMTP_MAIL_FROM=alerts@example.com
